{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/club-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/meeting-reminders",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/[job].js": {
      "maxDuration": 60
    },
    "api/os/[section].js": {
      "maxDuration": 60
    }
  }
}